<project name="ZmanimDisplay" default="release-install">

	<!-- The local.properties file is created and updated by the 'android' tool.
					 It contain the path to the SDK. It should *NOT* be checked in in Version
					 Control Systems. -->
	<property file="local.properties"/>

	<!-- The build.properties file can be created by you and is never touched
					 by the 'android' tool. This is the place to change some of the default property values
					 used by the Ant rules.
					 Here are some properties you may want to change/update:

					 application-package
							 the name of your application package as defined in the manifest. Used by the
							 'uninstall' rule.
					 source-folder
							 the name of the source folder. Default is 'src'.
					 out-folder
							 the name of the output folder. Default is 'bin'.

					 Properties related to the SDK location or the project target should be updated
						using the 'android' tool with the 'update' action.

					 This file is an integral part of the build system for your application and
					 should be checked in in Version Control Systems.

					 -->
	<property file="build.properties"/>

	<!-- The default.properties file is created and updated by the 'android' tool, as well
					 as ADT.
					 This file is an integral part of the build system for your application and
					 should be checked in in Version Control Systems. -->
	<property file="default.properties"/>

	<!-- Custom Android task to deal with the project target, and import the proper rules.
						 This requires ant 1.6.0 or above. -->
	<path id="android.antlibs">
		<pathelement path="${sdk.dir}/tools/lib/anttasks.jar"/>
		<pathelement path="${sdk.dir}/tools/lib/sdklib.jar"/>
		<pathelement path="${sdk.dir}/tools/lib/androidprefs.jar"/>
		<pathelement path="${sdk.dir}/tools/lib/apkbuilder.jar"/>
		<pathelement path="${sdk.dir}/tools/lib/jarutils.jar"/>
	</path>

	<taskdef name="setup"
	         classname="com.android.ant.SetupTask"
	         classpathref="android.antlibs"/>

	<!-- Execute the Android Setup task that will setup some properties specific to the target,
					 and import the build rules files.

					 The rules file is imported from
							<SDK>/platforms/<target_platform>/templates/android_rules.xml

					 To customize some build steps for your project:
					 - copy the content of the main node <project> from android_rules.xml
					 - paste it in this build.xml below the <setup /> task.
					 - disable the import by changing the setup task below to <setup import="false" />

					 This will ensure that the properties are setup correctly but that your customized
					 build steps are used.
			-->
	<setup/>


	<!-- Convert this project's .class files into .dex files. -->
	<!--
		Uncomment this if need to see what class is causing a warning like:
	    warning: Ignoring InnerClasses attribute for an anonymous inner class that doesn't come with an associated EnclosingMethod attribute. (This class was probably produced by a broken compiler.)
		Note that the single "-" needs to be changed to to a double "-" in the "arg" statements. Unforutunately,
		 ant gets unhappy with two "-" characters in a comment...
	-->
<!--
	<target name="dex" depends="compile">
	    <echo>Converting compiled files and external libraries into ${out-folder}/${dex-file}...</echo>
			<echo>MEMEMEMEMEMEME</echo>
	    <apply executable="${dx}" failonerror="true" parallel="true">
	        <arg value="-dex" />
			    <arg value="-verbose" />
	        <arg value="-output=${intermediate-dex-location}" />
	        <arg path="${out-classes-location}" />
	        <fileset dir="${external-libs-folder}" includes="*.jar"/>
	    </apply>
	</target>
-->


	<!--
		BEGIN Customized targets
	-->
	<property name="svnant.javahl" value="false" />
	<property name="svnant.svnkit" value="true" />	
	<path id="svnant.classpath">
		<fileset dir="${svnant.lib.dir}">
			<include name="**/*.jar"/>
		</fileset>
	</path>
	<typedef resource="org/tigris/subversion/svnant/svnantlib.xml" classpathref="svnant.classpath"/>

	<property file="flurry.properties"/>


	<target name="tool-availability">
		<available resource="org/tigris/subversion/svnant/svnantlib.xml"
		           classpathref="svnant.classpath"
		           property="available.svnant"
			/>
		<echo message="SVN-ANT is available = ${available.svnant}"/>
	</target>


	<target name="get-svn-state">
		<svn javahl="${svnant.javahl}" svnkit="${svnant.svnkit}">
			<wcversion path="." prefix="svn.status." />
		</svn>
	</target>


	<!--
		Takes care of updating the user-visible version string.
	-->
	<target name="set-version" depends="get-svn-state">

		<property file="version.number"/>
		<property file="build.number"/>

		<condition property="version" value="${version.major}.${version.minor}.${build.number}.${svn.status.committed.max}" else="${version.major}.${version.minor}.${build.number}.${svn.status.committed.max}-DEV">
			<isset property="release_build" />
		</condition>

		<echo>
			version.major = ${version.major}
			version.minor = ${version.minor}
			build.number  = ${build.number}

			version       = ${version}
		</echo>

	</target>


	<!--
		Takes care of updating the android:versionCode attribute so that we never screw that up and bumping the
			minor version number.
	-->
	<target name="update-release-version">

		<echo>Updating version number...</echo>
		<buildnumber file="build.number"/>

		<propertyfile file="version.number" comment="Zmanim Version">
			<!-- Actually, I don't want to bump the minor version every time.... -->
			<!--<entry key="version.minor" type="int" default="0" operation="+"/>-->
			<entry key="version.date" type="date" value="now"/>
		</propertyfile>

	</target>


	<target name="replace_version_placeholders" depends="set-version">

		<echo>Updating version in AndroidManifest.xml and strings.xml...</echo>
		<replaceregexp file="AndroidManifest.xml" match="android:versionName(.*)" replace='android:versionName="${version}"'/>
		<replaceregexp file="AndroidManifest.xml" match="android:versionCode(.*)" replace='android:versionCode="${build.number}"'/>

		<replaceregexp file="assets/com/gindin/zmanim/android/about.html" match='Version (.*)' replace='Version ${version}'/>

		<replaceregexp file="src/com/gindin/util/Version.java" match='public static final String androidVersionName(.*)' replace='public static final String androidVersionName = "${version}";'/>
		<replaceregexp file="src/com/gindin/util/Version.java" match='public static final int androidCodeVersion(.*)' replace='public static final int androidCodeVersion = ${build.number};'/>

	</target>


	<target name="build-setup">

		<echo>
			repository.url=${svn.status.repository.url}
			committed.max=${svn.status.committed.max}
			modified=${svn.status.modified}
		</echo>

		<!--
			If modified, then fail!??!!
				- No, because files which we're dynamically changing (based on the version) will be changed...
		-->
		<delete dir="bin"/>
	</target>


	<target name="build-debug" depends="build-setup">

		<property name="out-debug-package" value="${out-folder}/${ant.project.name}-debug.apk"/>
		
		<!-- Call back to the "real" Android build file to do the actual building... -->
		<antcall target="debug"/>
		<echo>Done building ${out-debug-package}.</echo>



	</target>


	<!--
		When performing a build for a new release, this target does it all:
		  * Builds the APK
		  * Signs the APK
		  * Aligns the APK
	-->                                      
	<target name="build-release" depends="build-setup">

		<!-- Much of this is because we're targeting Android 1.5, where the build rules aren't as sophisticated. -->
		<property name="zipalign" value="${android-tools}/zipalign${exe}" />
		<property name="adb" value="${android-tools}/adb${exe}"/>
		<property name="key.store" value="jay-gindin-android-apps.keystore"/>
		<property name="out-unsigned-package" value="${out-folder}/${ant.project.name}-unsigned.apk"/>
		<property name="out-unaligned-package" value="${out-folder}/${ant.project.name}-unaligned.apk"/>
		<property name="out-release-package" value="${out-folder}/${ant.project.name}-release-${version}.apk"/>

		<!-- Insert the flurry key -->
		<replace file="src/com/gindin/util/LogUtils.java" token="FLURRY_KEY_GOES_HERE" value="${flurry.key}"/>

		<!-- Call back to the "real" Android build file to do the actual building... -->
		<antcall target="release"/>

		<!-- Restore the flurry key placeholder -->
		<replace file="src/com/gindin/util/LogUtils.java" token="${flurry.key}" value="FLURRY_KEY_GOES_HERE" /> 


		<echo>Done building ${out-unsigned-package}.</echo>

		<input
			message="Please enter keystore password (store: ${key.store}):"
		  addproperty="key.store.password"/>


		<echo>Signing package...</echo>
		<signjar
			verbose="true"
			keystore="${key.store}"
			storepass="${key.store.password}"
			jar="${out-unsigned-package}"
			signedjar="${out-unaligned-package}"
			alias="android-app"
		/>
		<echo>Signed ${out-unaligned-package}</echo>

		<echo>Running zip align on the final, signed JAR...</echo>
		<exec executable="${zipalign}" failonerror="true">
			<arg value="-f" />
			<arg value="4" />
			<arg path="${out-unaligned-package}" />
			<arg path="${out-release-package}" />
		</exec>
		<echo>Release Package: ${out-release-package}</echo>

	</target>


	<!--
		Copies the .apk to an ACTUAL device that is plugged into the USB.
	-->
	<target name="usb-install">
		<echo>Installing ${apk-to-install}...</echo>
		<exec executable="${adb}" failonerror="true">
			<arg value="-d"/>
			<arg value="install"/>
			<arg value="-r"/>
			<arg path="${apk-to-install}"/>
		</exec>
	</target>


	<!--
		Takes care to set the necessary properties such that everyone else knows we're doing a real release.
	-->
	<target name="setup-for-release">
		<!-- Set this property so that we do the right versioning for an actual release. -->
		<property name="release_build" value="true"/>
	</target>


	<!--
		When performing a build for a new release, this target will get everything versioned and built properly,
			and will then deploy it to a locally attached device.
	-->
	<target name="release-install" depends="setup-for-release,update-release-version,replace_version_placeholders,build-release">

		<property name="apk-to-install" value="${out-release-package}"/>
		<antcall target="usb-install"/>

	</target>


	<!--
		Gets a debug build made and deployed.
	-->
	<target name="debug-install" depends="replace_version_placeholders,build-debug">

		<property name="apk-to-install" value="${out-debug-package}"/>
		<antcall target="usb-install"/>

	</target>

</project>
