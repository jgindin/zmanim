<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/main_layout"
	android:layout_width="fill_parent"
  android:layout_height="fill_parent"
	android:orientation="vertical"
	>

	<TableLayout xmlns:android="http://schemas.android.com/apk/res/android"
		android:id="@+id/main_content"
		android:layout_width="fill_parent"
		android:layout_height="0px"
		android:layout_weight="1"
		android:paddingLeft="4px"
		android:paddingRight="4px"
		android:stretchColumns="1"
		>

		<TableRow android:layout_width="fill_parent">
			<TextView
				android:id="@+id/location"
				android:text="Location"
				android:textStyle="bold"
				android:gravity="center"
				android:layout_gravity="center_horizontal"
				android:layout_span="2"
			/>
		</TableRow>

		<TableRow android:layout_width="fill_parent">
			<TextView
				android:id="@+id/secular_date"
				android:text="SecDate"
				android:textSize="12sp"
				android:bufferType="spannable"
			/>
			<TextView
				android:id="@+id/hebrew_date"
				android:text="HebDate"
				android:gravity="right"
				android:textSize="12sp"
			/>
		</TableRow>

		<TableRow android:layout_width="fill_parent">
			<TextView android:id="@+id/blank" android:text=""/>
		</TableRow>

		<TableRow android:layout_width="fill_parent">
			<TextView
				android:id="@+id/holiday"
				android:text=""
				android:textStyle="bold"
				android:gravity="center"
				android:layout_gravity="center_horizontal"
				android:layout_span="2"
				android:textSize="12sp"
			/>
		</TableRow>

		<TableRow android:layout_width="fill_parent">
			<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
				android:id="@+id/zmanim_view"
				android:layout_width="fill_parent"
				android:layout_height="wrap_content"
				android:scrollbars="none"
				android:layout_span="2">

				<TableLayout xmlns:android="http://schemas.android.com/apk/res/android"
					android:layout_width="fill_parent"
					android:layout_height="fill_parent"
					android:stretchColumns="1">

					<TableRow android:layout_width="fill_parent" android:id="@+id/alot_row">
						<TextView
							android:text="@string/Alot"
							android:textSize="12sp"
						/>
						<TextView
							android:id="@+id/alot"
							android:text="alot"
							android:gravity="right"
							android:textSize="12sp"
						/>
					</TableRow>

					<TableRow android:layout_width="fill_parent" android:id="@+id/talit_row">
						<TextView
							android:text="@string/Talit"
							android:textSize="12sp"
						/>
						<TextView
							android:id="@+id/talit"
							android:text="talit"
							android:gravity="right"
							android:textSize="12sp"
						/>
					</TableRow>

					<TableRow android:layout_width="fill_parent" android:id="@+id/hanetz_row">
						<TextView
							android:text="@string/Hanetz"
							android:textSize="12sp"
						/>
						<TextView
							android:id="@+id/hanetz"
							android:text="hanetz"
							android:gravity="right"
							android:textSize="12sp"
						/>
					</TableRow>

					<TableRow android:layout_width="fill_parent" android:id="@+id/sofZmanShema_row">

						<TextView
							android:text="@string/SofZmanShema"
							android:textSize="12sp"
						/>
						<TextView
							android:id="@+id/sofZmanShema"
							android:text="shema"
							android:gravity="right"
							android:textSize="12sp"
						/>
					</TableRow>

					<TableRow android:layout_width="fill_parent" android:id="@+id/sofZmanTefilah_row">

						<TextView
							android:text="@string/SofZmanTefilah"
							android:textSize="12sp"
						/>
						<TextView
							android:id="@+id/sofZmanTefilah"
							android:text="tefilah"
							android:gravity="right"
							android:textSize="12sp"
						/>
					</TableRow>

					<TableRow android:layout_width="fill_parent" android:id="@+id/chatzot_row">

						<TextView
							android:text="@string/Chatzot"
							android:textSize="12sp"
						/>
						<TextView
							android:id="@+id/chatzot"
							android:text="chatzot"
							android:gravity="right"
							android:textSize="12sp"
						/>
					</TableRow>

					<TableRow android:layout_width="fill_parent" android:id="@+id/minchaGedola_row">

						<TextView
							android:text="@string/MinchaGedola"
							android:textSize="12sp"
						/>
						<TextView
							android:id="@+id/minchaGedola"
							android:text="mincha gedola"
							android:gravity="right"
							android:textSize="12sp"
						/>
					</TableRow>

					<TableRow android:layout_width="fill_parent" android:id="@+id/minchaKetana_row">

						<TextView
							android:text="@string/MinchaKetana"
							android:textSize="12sp"
						/>
						<TextView
							android:id="@+id/minchaKetana"
							android:text="mincha ketana"
							android:gravity="right"
							android:textSize="12sp"
						/>
					</TableRow>

					<TableRow android:layout_width="fill_parent" android:id="@+id/plagHamincha_row">

						<TextView
							android:text="@string/Plag"
							android:textSize="12sp"
						/>
						<TextView
							android:id="@+id/plagHamincha"
							android:text="plag hamincha"
							android:gravity="right"
							android:textSize="12sp"
						/>
					</TableRow>

					<TableRow android:layout_width="fill_parent" android:id="@+id/candles_row">
						<TextView
							android:text="@string/Candles"
							android:textSize="12sp"
						/>
						<TextView
							android:id="@+id/candles"
							android:text="candles"
							android:gravity="right"
							android:textSize="12sp"
						/>
					</TableRow>

					<TableRow android:layout_width="fill_parent" android:id="@+id/shkiah_row">

						<TextView
							android:text="@string/Shkiah"
							android:textSize="12sp"
						/>
						<TextView
							android:id="@+id/shkiah"
							android:text="shkiah"
							android:gravity="right"
							android:textSize="12sp"
						/>
					</TableRow>

					<TableRow android:layout_width="fill_parent" android:id="@+id/mincha_row">

						<TextView
							android:text="@string/Mincha"
							android:textSize="12sp"
						/>
						<TextView
							android:id="@+id/mincha"
							android:text="mincha"
							android:gravity="right"
							android:textSize="12sp"
						/>
					</TableRow>

					<TableRow android:layout_width="fill_parent" android:id="@+id/tzait_row">
						<TextView
							android:text="@string/Tzait"
							android:textSize="12sp"
						/>
						<TextView
							android:id="@+id/tzait"
							android:text="tzait"
							android:gravity="right"
							android:textSize="12sp"
						/>
					</TableRow>

				</TableLayout>

			</ScrollView>

		</TableRow>

	</TableLayout>

	<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:scrollbars="none"
		>
		<TextView
			android:id="@+id/messages"
			android:layout_width="fill_parent"
			android:layout_height="fill_parent"
		/>
	</ScrollView>

</LinearLayout>

