<TableLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/main_layout"
	android:layout_width="fill_parent"
	android:layout_height="fill_parent"
	android:layout_weight="1"
	android:paddingLeft="4px"
	android:paddingRight="4px"
	android:stretchColumns="1"
	>

	<!-- Header -->

	<TableRow android:layout_width="fill_parent">
		<TextView
			android:id="@+id/location"
			android:textStyle="bold"
			android:gravity="center"
			android:layout_gravity="center_horizontal"
			android:layout_span="2"
		/>
	</TableRow>

	<TableRow android:layout_width="fill_parent">
		<TextView
			android:id="@+id/secular_date"
			android:bufferType="spannable"
		/>
		<TextView
			android:id="@+id/hebrew_date"
			android:gravity="right"
		/>
	</TableRow>

	<TableRow android:layout_width="fill_parent">
		<TextView android:id="@+id/blank" android:text=""/>
	</TableRow>

	<TableRow android:layout_width="fill_parent" android:id="@+id/holiday_row">
		<TextView
			android:id="@+id/holiday"
			android:text=""
			android:textStyle="bold"
			android:gravity="center"
			android:layout_gravity="center_horizontal"
			android:layout_span="2"
		/>
	</TableRow>

	<TableRow android:layout_width="fill_parent">

		<!--
			What? Another layout hiding in here? Oh, and huh? The footer is....before the list?
				Yes, well, it seems that the only way to get the footer to show up is this way. Chck out this
				from StackOverflow: http://stackoverflow.com/questions/2383847/android-layout-with-listview-and-buttons
		-->
		<RelativeLayout
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_span="2"
		>

			<!-- Footer -->
			<TextView
				android:id="@+id/messages"
				android:text=""
				android:layout_width="fill_parent"
				android:layout_height="wrap_content"
			  android:layout_alignParentBottom="true"
			  android:bufferType="spannable"
			/>

			<!-- The interesting stuff! -->
			<ListView
				android:id="@android:id/list"
				android:layout_width="fill_parent"
				android:layout_height="wrap_content"
				android:layout_alignParentTop="true"
				android:layout_above="@id/messages"
				android:drawSelectorOnTop="false"
			/>

		</RelativeLayout>
		
	</TableRow>

</TableLayout>
