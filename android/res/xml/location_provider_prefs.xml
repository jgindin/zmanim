<PreferenceScreen
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:orderingFromXml="true"
  android:title="@string/edit_location_prefs_title"
>

	<PreferenceCategory
		android:title="@string/dynamic_location"
	  android:orderingFromXml="true"
	>

		<!--
			See the com.gindin.zmanim.android.prefs.LocationProviders enum, which corresponds to the keys (e.g.,
			DYNAMIC_POSITION, STATIC_POSITION, LATITUDE_LONGITUDE_POSITION.
		-->

		<CheckBoxPreference
			android:key="DYNAMIC_POSITION"
		  android:title="@string/dynamic_position_pref_title"
		  android:summary="@string/dynaic_position_pref_summary"
		  android:checked="true"
		/>
		<CheckBoxPreference
			android:key="preferGPS"
		  android:title="@string/prefer_gps_pref_title"
		  android:summary="@string/prefer_gps_pref_summary"
		  android:dependency="DYNAMIC_POSITION"
		/>
	</PreferenceCategory>


	<PreferenceCategory
		android:title="@string/static_location"
	  android:orderingFromXml="true"
	>

		<CheckBoxPreference
			android:key="STATIC_POSITION"
		  android:title="@string/use_static_location_pref_title"
		  android:summary="@string/use_static_location_pref_summary"
		/>
		<EditTextPreference
			android:key="PLACE"
		  android:title="@string/static_location_pref_title"
		  android:summary="@string/static_location_pref_summary"
		  android:dependency="STATIC_POSITION"
		/>
	</PreferenceCategory>


	<PreferenceCategory
		android:title="@string/lat_long_location"
	  android:orderingFromXml="true"
	>

		<CheckBoxPreference
			android:key="LATITUDE_LONGITUDE_POSITION"
		  android:title="@string/use_latitude_longitued_pref_title"
		  android:summary="@string/use_latitude_longitued_pref_summary" 
		/>
		<EditTextPreference
			android:key="LATITUDE"
		  android:title="@string/use_latitude_pref_title"
		  android:summary="@string/use_latitude_pref_summary"
		  android:dependency="LATITUDE_LONGITUDE_POSITION"
		/>
		<EditTextPreference
			android:key="LONGITUDE"
		  android:title="@string/use_longitude_pref_title"
		  android:summary="@string/use_longitude_pref_summary"
		  android:dependency="LATITUDE_LONGITUDE_POSITION"
		/>

	</PreferenceCategory>

</PreferenceScreen>