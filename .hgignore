# Mercurial ignore file.
#
# All entries are regular expressions.
#
# Please note that unless the line starts with ^ then the pattern is NOT
# rooted.  IE:  *.c will match ANY .c file anywhere in the repository.
#
syntax: regexp

# Ignore files/directories generated by the build.
build/
ijcompile/
\.gradle/
hg.number

# Ignore vi swap files
.*.swp$

# Ignore generated files
^android/gen/
^android/bin/
^utils/gen/
^utils/bin/
^zmanLib/gen/
^zmanLib/bin/


# IntelliJ Files that are per-user and should not be checked in.
atlassian-ide-plugin.xml
\.idea/workspace.xml
\.idea/codeStyleSettings.xml
\.idea/scopes/scope_settings.xml
\.idea/uiDesigner.xml
\.idea/dictionaries/
\.idea/copyright/profiles_settings.xml
\.idea/findbugs-idea.xml
\.idea/shelf/*


# Ignore any backup files created by editors
.*~

# Ignore any patch related file that ends with ".orig"
\.orig$

# Ignore runtime-generated config/logging directories.
var/

# Ignore local property files
local.properties
