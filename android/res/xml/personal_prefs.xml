<PreferenceScreen
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:orderingFromXml="true"
  android:title="@string/personal_prefs"
>

	<!--
		See the com.gindin.zmanim.android.prefs.PersonalPrefernces.Prefs enum, which corresponds to the keys (e.g.,
		SHOW_SECONDS).
	-->

	<CheckBoxPreference
		android:key="SHOW_SECONDS"
	  android:title="@string/show_seconds_pref_title"
	  android:summary="@string/show_seconds_pref_summary"
	  android:checked="true"
	/>

	<CheckBoxPreference
		android:key="USE_ELEVATION"
	  android:title="@string/use_elevation_pref_title"
	  android:summary="@string/use_elevation_pref_summary"
	  android:checked="true"
	/>


</PreferenceScreen>