<LinearLayout
	android:id="@+id/layout_root"
	android:layout_width="fill_parent"
	android:layout_height="fill_parent"
	android:orientation="vertical"
	xmlns:android="http://schemas.android.com/apk/res/android"
	>
	<TableLayout
		android:layout_width="fill_parent"
		android:layout_height="wrap_content"
		android:orientation="vertical"
		android:layout_gravity="center_horizontal"
		>
		<TableRow
			android:layout_width="fill_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal"
			>
			<TextView
				android:id="@+id/help_navigation"
				android:text="@string/help_navigation"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				>
			</TextView>
		</TableRow>
		<TableRow
			android:layout_width="fill_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal"
			>
			<TextView android:text=""/>
		</TableRow>
		<TableRow
			android:layout_width="fill_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal"
			>
			<TextView
				android:id="@+id/help_swipe_left"
				android:text="@string/help_swipe_left"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				>
			</TextView>
		</TableRow>
		<TableRow
			android:layout_width="fill_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal"
			>
			<TextView
				android:id="@+id/help_swipe_right"
				android:text="@string/help_swipe_right"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				>
			</TextView>
		</TableRow>
		<TableRow
			android:layout_width="fill_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal"
			>
			<TextView
				android:id="@+id/help_swipe_up"
				android:text="@string/help_swipe_up"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				>
			</TextView>
		</TableRow>
		<TableRow
			android:layout_width="fill_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal"
			>
			<TextView
				android:id="@+id/help_swipe_down"
				android:text="@string/help_swipe_down"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				>
			</TextView>
		</TableRow>
		<TableRow
			android:layout_width="fill_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal"
			>
			<TextView android:text=""/>
		</TableRow>
		<TableRow
			android:layout_width="fill_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal"
			>
			<TextView android:text=""/>
		</TableRow>
		<TableRow
			android:layout_width="fill_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal"
			>
			<TextView
				android:id="@+id/zmanim_home"
				android:text="@string/zmanim_home"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				>
			</TextView>
		</TableRow>
 	</TableLayout>
</LinearLayout>
