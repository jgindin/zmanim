<!--
	I figured out the proper format for this file from https://github.com/twaddington/android-obd-logger/commit/95f3360a6cd12340214f134dfe5b896e1cf54539#diff-0
-->
<project name="AndroidZmanim_CustomRules">

	<property name="about.html" value="assets/com/gindin/zmanim/android/about.html"/>
	<import file="../common/versioning_rules.xml" optional="false"/>


	<!--
		This is my custom target extension.
	-->
	<target name="-pre-setup" depends="replace-version-placeholders,show-svn-info">
		<echo>-pre-setup</echo>
	</target>


	<!--
	 If this is set, then lot of additional stuff will get dumped out so you can see what's going on...
 -->
	<!--<property name="verbose" value="true" />-->

	<!--
		Extension targets. Uncomment the ones where you want to do custom work
		in between standard targets
	 -->
	<target name="-pre-build" depends="zmanim-replace-flurry-key-placeholders">
		<echo>-pre-build</echo>
	</target>


	<target name="-pre-compile">
		<echo>-pre-compile</echo>
	</target>

	<!--
		 This is typically used for code obfuscation. Compiled code location: ${out.classes.absolute.dir}
		 If this is not done in place, override ${out.dex.input.absolute.dir}]
	 -->
	<target name="-post-compile">
		<echo>-post-compile</echo>
	</target>

	<target name="-post-build" depends="zmanim-reset-flurry-key">
		<echo>-post-build</echo>
	</target>

	<target name="-pre-clean">
		<echo>-pre-clean</echo>
	</target>


	<!--
	 My custom targets
 -->

	<property file="flurry.properties"/>


	<!--
	  We don't want to store our flurry key in the source code...after all, we're hosting the code in a public
	  location! Instead, we write the code using a placeholder, and replace it here based on the contents of
	  a file that is NEVER committed to svn...
	-->
	<target name="zmanim-replace-flurry-key-placeholders">
		<replace file="src/com/gindin/util/LogUtils.java" token="FLURRY_KEY_GOES_HERE" value="${flurry.key}"/>
	</target>


	<target name="zmanim-reset-flurry-key">
		<replace file="src/com/gindin/util/LogUtils.java" token="${flurry.key}" value="FLURRY_KEY_GOES_HERE"/>
	</target>


	<!--
		Takes care to set the necessary properties such that everyone else knows we're doing a real release.
	-->
	<target name="zmanim-setup-for-release">
		<!-- Set this property so that we do the right versioning for an actual release. -->
		<property name="release_build" value="true"/>
	</target>


	<!--
		Deploys a release build .apk to a locally attached device.
	-->
	<target name="install-release-to-device" if="install-zmanim">

		<property name="apk-to-install" value="${out.release.file}"/>
		<antcall target="usb-install"/>

	</target>


	<!--
		Deploys a debug build .apk to a locally attached device.
	-->
	<target name="install-debug-to-device">

		<property name="apk-to-install" value="${out.debug.file}"/>
		<antcall target="usb-install"/>

	</target>


	<!--
		Copies the .apk to an ACTUAL device that is plugged into the USB.
	-->
	<target name="usb-install">
		<echo>Installing ${apk-to-install}...</echo>
		<exec executable="${adb}" failonerror="true">
			<arg value="-d"/>
			<arg value="install"/>
			<arg value="-r"/>
			<arg path="${apk-to-install}"/>
		</exec>
	</target>

</project>