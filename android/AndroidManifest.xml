<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  package="com.gindin.zmanim.android"
	android:versionCode="98"
  android:versionName="3.4.98.335-DEV"
>

	<!-- In order for the supports-screens to work right, we have to specify the target SDK of at least 11. -->
	<uses-sdk
		android:minSdkVersion="3"
	  android:targetSdkVersion="11"
	/>

	<!--
	For debugging, swap in this version:
	<application android:icon="@drawable/icon" android:label="Zmanim" android:debuggable="true">
	-->

	<application android:icon="@drawable/icon" android:label="Zmanim">
		<activity
			android:name=".ZmanimActivity"
		>
			<intent-filter>
				<action android:name="android.intent.action.MAIN"/>
				<category android:name="android.intent.category.LAUNCHER"/>
			</intent-filter>
		</activity>

		<activity
			android:name=".prefs.EditLocationProviderPreferences"
			android:label=".EditLocationPrefs"
		/>
		<activity
			android:name=".prefs.PersonalPreferences"
			android:label="Personal Preferences"
		/>

	</application>

	<!--
		Taken from http://www.devx.com/wireless/Article/40524 for accessing coarse location
	-->
	<uses-permission android:name="android.permission.INTERNET" />
	<uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
	<uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

	<supports-screens
		android:smallScreens="true"
    android:normalScreens="true"
    android:largeScreens="true"
    android:xlargeScreens="true"
	/>

</manifest>
