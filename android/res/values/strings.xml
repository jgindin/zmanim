	<string name="help_header">Zmanim Help</string>
	<string name="help_text">
		&lt;h2&gt;&lt;center&gt;How to Navigate Dates&lt;/center&gt;&lt;/h2&gt;
		&lt;ul&gt;
			&lt;li&gt;Swipe left to move to the previous day&lt;/li&gt;
			&lt;li&gt;Swipe right to move to the next day&lt;/li&gt;
			&lt;li&gt;Swipe up to move to the next month, but the same day of the month&lt;/li&gt;
			&lt;li&gt;Swipe down to move to the previous month, but the same day of the month&lt;/li&gt;
		&lt;/ul&gt;
		&lt;p&gt;
			You can also 'click' on the secular date to see a date selection dialog box.
		&lt;/p&gt;
	</string>

