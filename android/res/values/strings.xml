	<string name="help_menu">Help</string>
	<string name="help_header">Zmanim Help</string>
	<string name="help_text">
		&lt;h4&gt;Changing Zmanim&lt;/h4&gt;
		&lt;span style=%22font-size: 80%25;%22&gt;
			&lt;ul&gt;
				&lt;li&gt;Click on the zman you want to change&lt;/li&gt;
				&lt;li&gt;In the resulting dialog, click on the desired calculation&lt;/li&gt;
				&lt;li&gt;The dialog will go away, and that choice will be remembered every time you run android-zmanim.&lt;/li&gt;
			&lt;/ul&gt;
		&lt;/span&gt;
		&lt;h4&gt;Changing Dates&lt;/h4&gt;
		&lt;div style=%22font-size: 80%25;%22&gt;
			Click on the secular date in the upper left-hand corner to get a date selector.
		&lt;/div&gt;
	</string>

