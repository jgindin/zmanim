# Mercurial ignore file.
#
# All entries are regular expressions.
#
# Please note that unless the line starts with ^ then the pattern is NOT
# rooted.  IE:  *.c will match ANY .c file anywhere in the repository.
#
syntax: regexp

# Ignore files/directories generated by the build.
build/
ijcompile/
\.gradle/
hg.number

# Ignore vi swap files
.*.swp$

# Ignore generated files
^Android/gen/
^Android/bin/
^ZmanUtils/gen/
^ZmanUtils/bin/
^ZmanLib/gen/
^ZmanLib/bin/


# Ignore any backup files created by editors
.*~

# Ignore any patch related file that ends with ".orig"
\.orig$

# Ignore runtime-generated config/logging directories.
var/

# Ignore local property files
local.properties

# Sensitive files which are symlinked in, but NEVER committed
^common/jay-gindin-android-apps.keystore
^common/ProjectApiKey.txt
^ZehutYosef/zehut-yosef.gradle
^Android/zmanim.gradle


### JetBrains template
# Covers JetBrains IDEs: IntelliJ, RubyMine, PhpStorm, AppCode, PyCharm, CLion, Android Studio and Webstorm
# Reference: https://intellij-support.jetbrains.com/hc/en-us/articles/206544839
.*.iml$

# User-specific stuff:
.idea/workspace.xml
.idea/tasks.xml
.idea/dictionaries
.idea/jsLibraryMappings.xml
^.idea/uiDesigner.xml
^.idea/copyright/profiles_settings.xml
^.idea/findbugs-idea.xml
^.idea/shelf/
^.idea/modules
^.idea/issues.xml

# Sensitive or high-churn files:
.idea/dataSources.ids
.idea/dataSources.xml
.idea/dataSources.local.xml
.idea/sqlDataSources.xml
.idea/dynamic.xml
.idea/uiDesigner.xml

# Gradle:
.idea/gradle.xml
.idea/libraries

# Mongo Explorer plugin:
.idea/mongoSettings.xml

## Plugin-specific files:

# IntelliJ
/out/
.idea/caches/

# JIRA plugin
atlassian-ide-plugin.xml

# Crashlytics plugin (for Android Studio and IntelliJ)
com_crashlytics_export_strings.xml
crashlytics.properties
crashlytics-build.properties
fabric.properties


# Files generated during our build
Android/src/main/assets/com/gindin/zmanim/android/about.html
.superpowers/
